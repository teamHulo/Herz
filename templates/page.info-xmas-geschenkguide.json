        "88aa3b98-c224-4b7c-9456-2eb5548dc0f1": {
          "type": "column",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/Winterthur_Babyladen_Gutschein_Sarahs_silk_Montessori_Waldorf_Spielseide_Ozean1.jpg",
            "title": "Vielfältig einsetzbar: Bunte Seidentücher",
            "text": "<p>Spielseide ist vielseitig einsetzbar und bereichert jedes Spiel: Zum Beispiel zum Verkleiden, zum Häuschenbauen, als Puppendecke, als grüne Weide für Tiere, als blauer See für Schiffchen, als Suppe in einem Topf zum Umrühren, zum Schwingen zur Musik, zum Einpacken von Geschenken, und und und... Die Tücher eignen sich auch hervorragend zum Dekorieren des Jahreszeitentischs.</p>",
            "link_label": "Zu den Seidetüchern",
